      "src": "/images/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],

  "categories": [
    "utilities",
    "finance"
  ],

  "prefer_related_applications": false,

  "shortcuts": []
}
